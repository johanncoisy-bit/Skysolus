---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import { zones } from '../../content';
---
<Base title="Zones d’intervention : Var, PACA, France · Skysolus" description="Skysolus intervient depuis Hyères dans tout le Var (Toulon, Saint-Tropez, Fréjus, Provence verte…), en région PACA et partout en France.">
  <PageHead crumbs={[['Accueil', '/'], ['Zones d’intervention']]} title="Où nous intervenons" lead="Basé à Hyères, Skysolus intervient dans tout le Var, en région PACA, partout en France et, selon la faisabilité réglementaire, en outre-mer et à l’international." />
  <section class="wrap" style="padding-bottom:110px">
    <ul class="zone-list">
      {zones.map((z) => <li><a href={`/zones/${z.slug}`}><strong>{z.ville}</strong><span>{z.intro}</span></a></li>)}
    </ul>
  </section>
  <CtaBand />
</Base>
