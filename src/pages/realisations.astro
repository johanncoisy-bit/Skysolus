---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { realisations } from '../content';
---
<Base title="Réalisations : missions par drone et ULM dans le Var · Skysolus" description="Les missions réalisées par Skysolus dans le Var et en PACA : prises de vues, inspections, thermographie, cartographie et surveillance aérienne.">
  <PageHead crumbs={[['Accueil', '/'], ['Réalisations']]} title="Réalisations" />
  <section class="wrap" style="padding-bottom:110px">
    {realisations.length === 0 ? (
      <div class="empty">
        <p class="lead">Skysolus a démarré son activité en septembre 2026. Les premières missions seront présentées ici, avec l’accord des clients.</p>
        <p class="lead">Vous avez un projet ? Il pourrait être le prochain.</p>
        <a class="btn" href="/contact" style="margin-top:20px">Demander un devis</a>
      </div>
    ) : (
      <div class="works">
        {realisations.map((r) => (
          <article class="work">
            <img src={r.image} alt={r.titre} loading="lazy" width="800" height="500" />
            <div><p class="type">{r.prestation} · {r.lieu} · {r.date}</p><h2>{r.titre}</h2><p>{r.texte}</p></div>
          </article>
        ))}
      </div>
    )}
  </section>
  <CtaBand />
</Base>
