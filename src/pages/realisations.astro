---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config';
import { realisations, categoriesGalerie } from '../content';
const total = realisations.length;
---
<Base title="Réalisations : galerie des missions par drone · Skysolus" description="Galerie des missions réalisées par Skysolus : immobilier, inspection technique, suivi de chantier, thermographie et autres réalisations.">
  <PageHead crumbs={[['Accueil', '/'], ['Réalisations']]} title="Réalisations" lead={total ? 'Une sélection de missions, classées par type. Les images sont publiées avec l’accord des clients.' : undefined} />
  <section class="wrap" style="padding-bottom:110px">
    <nav class="other" style="margin-top:0" aria-label="Types de mission">
      <ul style="margin-top:0">{categoriesGalerie.map(([id, nom]) => <li><a href={`#${id}`}>{nom}</a></li>)}</ul>
    </nav>

    {total === 0 && (
      <div class="empty">
        <p class="lead">Skysolus a démarré son activité en septembre 2026. Les premières missions seront présentées ici, classées par type, avec l’accord des clients.</p>
        <p class="lead">Vous avez un projet ? Il pourrait être le prochain.</p>
        <div class="intro-actions" style="margin-top:20px"><a class="btn" href="/contact">Demander un devis</a><a class="btn btn-ghost" href={SITE.contact.telHref}>{SITE.contact.telephone}</a></div>
      </div>
    )}

    {categoriesGalerie.map(([id, nom]) => {
      const items = realisations.filter((r) => r.categorie === id);
      return (
        <section class="galerie-cat" id={id}>
          <h2>{nom}</h2>
          {items.length === 0 ? (
            <p class="muted">Réalisations à venir.</p>
          ) : (
            <ul class="galerie">
              {items.map((r) => (
                <li>
                  <figure>
                    <img src={r.image} alt={r.alt} loading="lazy" decoding="async" width="800" height="533" />
                    <figcaption>
                      <strong>{r.mission}</strong>
                      <span>{r.objectif}</span>
                      {r.lieu && <span class="muted">{r.lieu}</span>}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          )}
        </section>
      );
    })}
  </section>
  <CtaBand />
</Base>
