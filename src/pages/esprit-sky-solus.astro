---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { esprit } from '../content';
import { SITE } from '../config';
---
<Base title="L’esprit Skysolus : une passion pour l’aérien, une culture de la sécurité" description="Skysolus est né de la passion de Johann Coisy pour l’aéronautique : un drone est d’abord un aéronef, abordé avec la culture de sécurité et de rigueur d’un pilote avion.">
  <PageHead crumbs={[['Accueil', '/'], ['L’esprit Skysolus']]} title="L’esprit Skysolus" />
  <section class="wrap" style="padding-bottom:100px">
    <div class="svc-grid">
      <div class="esprit">
        {esprit.paragraphes.map((t) => <p class="lead">{t}</p>)}
        <blockquote class="citation">
          <p>« {esprit.citation} »</p>
          <footer>{SITE.contact.nom}, fondateur de Skysolus</footer>
        </blockquote>
        <p class="lead">{esprit.conclusion}</p>
      </div>
      <aside class="svc-aside">
        <h2>Skysolus en bref</h2>
        <ul>
          <li>{SITE.legal.forme}, créée en septembre 2026.</li>
          <li>Siège à {SITE.ville} ({SITE.departement})</li>
          <li>Fondateur : {SITE.legal.president}, licence de pilote avion depuis 2014 et télépilote de drone professionnel depuis 2026</li>
          <li>Moyens aériens : un DJI Mini 5 Pro, un DJI Matrice 4T, un ULM Bristell XL8 (<a href="/moyens-aeriens">voir</a>)</li>
        </ul>
        <div class="aside-actions">
          <a class="btn" href="/contact">Contacter</a>
          <a class="btn btn-ghost btn-tel" href={SITE.contact.telHref} title={SITE.contact.telephone} aria-label={`Appeler le ${SITE.contact.telephone}`}><svg class="ico-tel" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6.6 3.5h2.6l1.3 4-2 1.4a12.5 12.5 0 0 0 6.6 6.6l1.4-2 4 1.3v2.6A2 2 0 0 1 18.5 19.5 15 15 0 0 1 4.5 5.5a2 2 0 0 1 2.1-2z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>Appeler</a>
        </div>
      </aside>
    </div>
    <h2 style="margin-top:90px">Nos engagements</h2>
    <dl class="engage">
      {esprit.engagements.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}
    </dl>
  </section>
  <CtaBand />
</Base>
