---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { esprit } from '../content';
import { SITE } from '../config';
---
<Base title="L’esprit Sky Solus : une passion pour l’aérien, une culture de la sécurité" description="Sky Solus est né de la passion de Johann Coisy pour l’aéronautique : un drone est d’abord un aéronef, abordé avec la culture de sécurité et de rigueur d’un pilote avion.">
  <PageHead crumbs={[['Accueil', '/'], ['L’esprit Sky Solus']]} title="L’esprit Sky Solus" />
  <section class="wrap" style="padding-bottom:100px">
    <div class="svc-grid">
      <div class="esprit">
        {esprit.paragraphes.map((t) => <p class="lead">{t}</p>)}
        <blockquote class="citation">
          <p>« {esprit.citation} »</p>
          <footer>{SITE.contact.nom}, fondateur de Sky Solus</footer>
        </blockquote>
        <p class="lead">{esprit.conclusion}</p>
      </div>
      <aside class="svc-aside">
        <h2>Sky Solus en bref</h2>
        <ul>
          <li>{SITE.legal.forme}, créée le {SITE.legal.dateCreation}</li>
          <li>Siège à {SITE.ville} ({SITE.departement})</li>
          <li>Fondateur : {SITE.legal.president}, licence de pilote avion depuis 2014</li>
          <li>Moyens : un DJI Mini 5 Pro, un DJI Matrice 4T, un ULM Bristell XL8 (<a href="/moyens-aeriens">voir</a>)</li>
        </ul>
        <a class="btn" href="/contact">Contacter Johann</a>
        <a class="btn btn-ghost aside-tel" href={SITE.contact.telHref}>{SITE.contact.telephone}</a>
      </aside>
    </div>
    <h2 style="margin-top:90px">Nos engagements</h2>
    <dl class="engage">
      {esprit.engagements.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}
    </dl>
  </section>
  <CtaBand />
</Base>
