---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import PrestationCards from '../../components/PrestationCards.astro';
import { autresApplications } from '../../prestations';
---
<Base title="Prestations par drone et ULM : immobilier, inspection, chantier, thermographie · Sky Solus" description="Photo et vidéo aériennes pour l’immobilier, inspection visuelle et technique, suivi de chantier et thermographie aérienne par drone, depuis Hyères (Var).">
  <PageHead crumbs={[['Accueil', '/'], ['Prestations']]} title="Nos prestations" />
  <section class="wrap" style="padding-bottom:40px">
    <PrestationCards titre="h2" />
    <p class="muted" style="margin-top:22px">Vous cherchez par métier ? <a href="/secteurs">Voir les secteurs d’activité</a></p>
  </section>

  <section class="wrap" id="autres" style="padding:60px 0 110px">
    <div class="autres">
      <div>
        <h2 style="font-size:clamp(1.7rem,3vw,2.3rem)">Autres applications</h2>
        <p class="lead" style="margin-top:16px">D’autres missions peuvent être étudiées au cas par cas, selon les compétences et les moyens disponibles. Parlez-nous de votre projet : nous vous dirons ce qu’il est possible de faire.</p>
        <a class="btn btn-ghost" href="/contact" style="margin-top:12px">Parler de votre projet</a>
      </div>
      <dl>
        {autresApplications.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}
      </dl>
    </div>
  </section>
  <CtaBand />
</Base>
