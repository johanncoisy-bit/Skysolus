---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import { prestations, urlPrestation, introPrestations as intro } from '../../prestations';
---
<Base title="Nos prestations par drone : inspection, thermographie, 3D, chantier, audiovisuel · Skysolus" description="Inspection technique, thermographie, cartographie et 3D, suivi de chantier, agriculture, audiovisuel, surveillance et missions spécifiques par drone et ULM, depuis Hyères (Var).">
  <PageHead crumbs={[['Accueil', '/'], ['Prestations']]} title={intro.titre} lead={intro.sousTitre} />
  <section class="wrap" style="padding-bottom:110px">
    <div class="presta-intro">{intro.texte.map((t) => <p>{t}</p>)}</div>

    <ol class="presta-liste">
      {prestations.map((p, i) => (
        <li id={p.id}>
          <h2><span class="num">{i + 1}.</span> <a href={urlPrestation(p.id)}>{p.titre}</a>{p.statut === 'preparation' && <span class="badge badge-inline">En développement</span>}</h2>
          <ul class="puces">{p.liste.map((t) => <li>{t}.</li>)}</ul>
          <a class="card-more" href={urlPrestation(p.id)}>En savoir plus<span class="visually-hidden"> : {p.titre}</span> →</a>
        </li>
      ))}
    </ol>

    <div class="presta-signature">
      <p class="sig">{intro.signature}</p>
      <p class="lead">{intro.zone}</p>
      <p class="muted" style="margin-top:14px">Vous cherchez par métier ? <a href="/secteurs">Voir les secteurs d’activité</a></p>
    </div>
  </section>
  <CtaBand />
</Base>
