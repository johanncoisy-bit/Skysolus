---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
import { prestations, APPAREILS } from '../../data';
import { pagesSeo } from '../../seo';

export function getStaticPaths() {
  return prestations.map((p) => ({ params: { slug: pagesSeo[p.id].slug }, props: { id: p.id } }));
}
const { id } = Astro.props;
const p = prestations.find((x) => x.id === id)!;
const seo = pagesSeo[id];
const url = new URL(`/prestations/${seo.slug}`, SITE.url).href;
const jsonld = [
  {
    '@context': 'https://schema.org', '@type': 'Service', name: p.titre, serviceType: p.titre, description: seo.description, url,
    provider: { '@id': `${SITE.url}/#entreprise` },
    areaServed: [{ '@type': 'AdministrativeArea', name: 'Var' }, { '@type': 'AdministrativeArea', name: 'Provence-Alpes-Côte d’Azur' }],
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: seo.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Prestations', item: `${SITE.url}/#prestations` },
      { '@type': 'ListItem', position: 3, name: p.titre, item: url },
    ],
  },
];
const autres = prestations.filter((x) => x.id !== id);
---
<Base title={seo.title} description={seo.description} jsonld={jsonld}>
  <section class="wrap svc-hero">
    <nav class="crumbs" aria-label="Fil d’Ariane"><a href="/">Accueil</a> / <a href="/#prestations">Prestations</a> / {p.titre}</nav>
    <h1>{seo.h1}</h1>
  </section>
  <section class="wrap" style="padding-bottom:120px">
    <div class="svc-grid">
      <div>
        {seo.intro.map((t) => <p class="lead">{t}</p>)}
        <h2 style="font-size:1.6rem;margin:44px 0 14px">Exemples de missions</h2>
        <ul style="color:#cfdbe9;padding-left:1.1em">{p.exemples.map((e) => <li>{e}</li>)}</ul>
      </div>
      <aside class="svc-aside">
        <h2>Ce que vous recevez</h2>
        <ul>{seo.livrables.map((l) => <li>{l}</li>)}</ul>
        <h2>Appareils utilisés</h2>
        <div class="tags">{p.avec.map((a) => <span class={`tag tag-${a}`}>{APPAREILS[a]}</span>)}</div>
        <a class="btn" href="/#contact">Demander un devis</a>
      </aside>
    </div>
    <div class="faq">
      <h2 style="font-size:2rem;margin-bottom:20px">Questions fréquentes</h2>
      {seo.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </div>
    <div class="other">
      <h2 style="font-size:1.5rem">Autres prestations</h2>
      <ul>{autres.map((x) => <li><a href={`/prestations/${pagesSeo[x.id].slug}`}>{x.titre}</a></li>)}</ul>
    </div>
  </section>
</Base>
