---
import Base from '../layouts/Base.astro';
import Plane from '../components/Plane.astro';
import Drone from '../components/Drone.astro';
import ContactForm from '../components/ContactForm.astro';
import PrestationCards from '../components/PrestationCards.astro';
import { SITE } from '../config';
import { methode } from '../data';
import { secteurs } from '../secteurs';
import { esprit } from '../content';
const faq = [
  ['Quelles prestations proposez-vous ?', 'Inspection technique et industrielle, thermographie aérienne, cartographie et modélisation 3D, suivi de chantiers et BTP, agriculture et environnement, audiovisuel et communication (dont la valorisation immobilière), surveillance et observation aérienne, et des missions spécifiques comme le repérage de nids de frelons.'],
  ['Intervenez-vous partout en France ?', 'Oui. Skysolus est basé à Hyères (Var) et peut intervenir partout en France, en Corse et en Outre-mer, sur devis. Le déplacement est indiqué dans le devis.'],
  ['Une inspection par drone remplace-t-elle un diagnostic ?', 'Non. Le drone fournit des images et des informations utiles, mais ne remplace pas systématiquement un diagnostic réglementaire ou spécialisé. Une anomalie non visible sur les images ne peut pas être exclue.'],
  ['À quoi sert l’ULM ?', 'L’ULM Bristell XL8 permet d’observer de grandes étendues en une sortie : littoral, massifs forestiers, grands sites. Il sert à la surveillance et à l’observation aérienne, et au suivi d’espaces naturels.'],
  ['Pouvez-vous voler en ville ?', 'Le vol en agglomération demande une démarche particulière et n’est pas toujours possible. Chaque adresse est vérifiée avant de vous proposer un devis.'],
  ['Comment obtenir un devis ?', 'Décrivez votre projet via le formulaire, par téléphone ou par e-mail : le lieu, ce que vous voulez voir, suivre ou montrer. Vous pouvez joindre des photos. Nous revenons vers vous avec une proposition adaptée.'],
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };

const rings = [
  { r: 62, label: 'Var' },
  { r: 132, label: 'Région PACA' },
  { r: 202, label: 'France et Outre-mer' },
  { r: 272, label: 'Au-delà, selon faisabilité' },
];
---
<Base
  title="Skysolus · Missions aériennes par drone et ULM, depuis Hyères (Var)"
  description="Skysolus réalise vos missions aériennes par drone et ULM : photo et vidéo pour l’immobilier, suivi de chantier, inspection technique, thermographie. Basé à Hyères (Var)."
  jsonld={[faqLd]}
>
  <section class="hero" aria-label="Film de présentation">
    <video id="film" autoplay muted loop playsinline preload="metadata" poster="/video/poster.jpg">
      <source src="/video/skysolus-intro-mobile-v21.mp4" type="video/mp4" media="(max-width: 760px)" />
      <source src="/video/skysolus-intro-v21.mp4" type="video/mp4" />
    </video>
    <div class="hero-bar">
      <div class="hero-ctrl">
        <button class="hero-play" id="film-btn" type="button" aria-controls="film">Mettre en pause</button>
        <button class="hero-play" id="film-son" type="button" aria-controls="film" aria-pressed="false">Activer le son</button>
      </div>
      <a class="hero-down" href="#intro">Découvrir <span aria-hidden="true"></span></a>
    </div>
  </section>

  <section class="intro wrap" id="intro">
    <h1 class="intro-titre">Skysolus, vos missions aériennes par drone et ULM pour l’immobilier, le suivi de chantier, l’inspection technique, et plus encore.</h1>
    <p class="lead">Particuliers, professionnels et collectivités : chaque mission est préparée selon votre besoin, le site et la réglementation, depuis notre base de Hyères, dans le Var.</p>
    <div class="intro-actions">
      <a class="btn" href="/prestations">Découvrir nos prestations</a>
      <a class="btn btn-ghost" href="/contact">Demander un devis</a>
      <a class="btn btn-ghost" href={SITE.contact.telHref}>Appeler le {SITE.contact.telephone}</a>
    </div>
    <ul class="facts">
      <li><strong>Basé à Hyères</strong>Interventions dans le Var mais aussi partout en France et Outre-mer.</li>
      <li><strong>Drone et ULM</strong>Le détail au plus près avec le drone, les grandes étendues avec l’avion.</li>
      <li><strong>Des limites expliquées</strong>Ce que les images permettent de conclure, et ce qu’elles ne permettent pas.</li>
    </ul>
  </section>

  <section class="section wrap" id="prestations">
    <div class="presta-head">
      <div>
        <h2>Nos prestations</h2>
        <p class="lead">Des explications simples, des exemples concrets et des limites clairement indiquées.</p>
      </div>
      <a class="btn btn-ghost" href="/prestations">Toutes les prestations</a>
    </div>
    <div style="margin-top:44px"><PrestationCards /></div>
  </section>

  <section class="section clients">
    <div class="wrap">
      <h2>Pour qui</h2>
      <p class="lead" style="margin-top:18px">Particuliers, entreprises et collectivités : trouvez les prestations qui correspondent à votre activité.</p>
      <dl>
        {secteurs.map((s) => <div><dt><a class="presta-link" href={`/secteurs#${s.id}`}>{s.titre}</a>{s.enDeveloppement && <span class="badge badge-inline">En développement</span>}</dt><dd>{s.texte}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section flotte" id="flotte">
    <div class="wrap">
      <div class="flotte-head">
        <h2>Nos moyens aériens</h2>
        <p class="lead">Les drones travaillent au plus près des bâtiments et des sites. Au-dessus, l’ULM observe de grandes étendues en une sortie.</p>
      </div>

      <div class="ulm appareil">
        <Plane />
        <div>
          <p class="type">Avion ultraléger (ULM)</p>
          <h3>Bristell XL8</h3>
          <p>Un biplace à aile basse et grande verrière, pensé pour la visibilité. Il emmène l’observateur au-dessus de vastes territoires.</p>
          <ul>
            <li>Surveillance et observation de grandes étendues</li>
            <li>Littoral et massifs forestiers</li>
            <li>Suivi d’espaces naturels</li>
          </ul>
        </div>
      </div>

      <div class="plafond" role="presentation"><p>120 m : hauteur maximale d’un drone en catégorie Ouverte</p></div>

      <div class="drones">
        <div class="appareil">
          <Drone model="M4T" />
          <p class="type">Drone d’inspection</p>
          <h3>DJI Matrice 4T</h3>
          <p>Un drone professionnel équipé d’une caméra thermique, de caméras zoom et d’un télémètre laser, pour observer à distance ce qui est difficile d’accès.</p>
          <ul>
            <li>Inspection technique et thermographie</li>
            <li>Cartographie et modélisation 3D</li>
            <li>Suivi de chantier et surveillance</li>
          </ul>
        </div>
        <div class="appareil">
          <Drone model="Mini" />
          <p class="type">Drone photo et vidéo</p>
          <h3>DJI Mini 5 Pro</h3>
          <p>Compact et discret, il est conçu pour la photo et la vidéo : présenter un bien, un terrain ou un lieu dans son environnement.</p>
          <ul>
            <li>Valorisation immobilière : maisons, terrains, locaux</li>
            <li>Suivi de chantier</li>
            <li>Images pour le web et les réseaux sociaux</li>
          </ul>
        </div>
      </div>
      <a class="btn btn-ghost" href="/moyens-aeriens" style="margin-top:56px">Capacités et limites de chaque appareil</a>
    </div>
  </section>

  <section class="section wrap">
    <div class="esprit-teaser">
      <p class="type">L’esprit Skysolus</p>
      <blockquote class="citation"><p>« {esprit.citation} »</p><footer>{SITE.contact.nom}, fondateur</footer></blockquote>
      <a class="btn btn-ghost" href="/esprit-sky-solus">Découvrir l’esprit Skysolus</a>
    </div>
  </section>

  <section class="section wrap" id="zone">
    <div class="zone-grid">
      <div>
        <h2>Depuis Hyères, jusqu’où il faut</h2>
        <p class="lead" style="margin-top:20px">La base est à Hyères, entre la presqu’île de Giens et les îles d’Or. Les missions se déplacent selon le besoin.</p>
        <ul>
          <li><b>Var</b><span>Toulon, Hyères, Saint-Tropez, la Provence verte et l’arrière-pays.</span></li>
          <li><b>PACA</b><span>Bouches-du-Rhône, Alpes-Maritimes, Vaucluse, Alpes.</span></li>
          <li><b>France</b><span>Toutes les régions, la Corse et l’Outre-mer, sur devis. <a href="/france">Voir les régions</a></span></li>
          <li><b>Au-delà</b><span>International, à étudier selon la faisabilité réglementaire.</span></li>
        </ul>
        <a class="btn btn-ghost" href="/zones" style="margin-top:28px">Voir les zones d’intervention</a>
      </div>
      <svg class="rings" viewBox="0 0 600 600" role="img" aria-label="Zone d'intervention en cercles autour d'Hyères : Var, région PACA, France et Outre-mer, et international selon faisabilité">
        <defs>
          <radialGradient id="zg" cx=".5" cy=".5" r=".5">
            <stop offset="0" stop-color="#4CA9D4" stop-opacity=".35" /><stop offset="1" stop-color="#4CA9D4" stop-opacity="0" />
          </radialGradient>
        </defs>
        <circle cx="300" cy="300" r="290" fill="url(#zg)" />
        {rings.map((g, i) => (
          <g>
            <circle cx="300" cy="300" r={g.r} fill="none" stroke="#9BD6F2" stroke-opacity={0.55 - i * 0.1} stroke-width="1.5" stroke-dasharray={i === 3 ? '6 8' : undefined} />
            <text x="300" y={300 - g.r - 9} font-size="17" text-anchor="middle">{g.label}</text>
          </g>
        ))}
        <circle cx="300" cy="300" r="7" fill="#F2B66D" />
        <circle cx="300" cy="300" r="16" fill="none" stroke="#F2B66D" stroke-opacity=".6" />
        <text x="300" y="338" font-size="20" text-anchor="middle">Hyères</text>
      </svg>
    </div>
  </section>

  <section class="section methode" id="methode">
    <div class="wrap">
      <h2>Comment se déroule une mission</h2>
      <ol class="steps">
        {methode.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section wrap">
    <div class="cadre-grid">
      <div>
        <h2>Voler dans les règles</h2>
        <p class="lead" style="margin-top:20px">Chaque mission est classée selon son niveau de risque et réalisée dans le cadre réglementaire qui s’applique.</p>
      </div>
      <ul>
        <li>Missions drone en catégorie Ouverte ou Spécifique selon le site et la nature du vol, avec les déclarations ou autorisations nécessaires.</li>
        <li>Vérification préalable de l’espace aérien, des zones réglementées et des restrictions de prise de vues.</li>
        <li>Respect de la vie privée, du droit à l’image et de la protection des données.</li>
        <li>Pulvérisation et largage : non proposés. Vol de nuit ou hors vue : étudiés au cas par cas avant toute proposition.</li>
      </ul>
    </div>
  </section>

  <section class="section wrap" id="faq">
    <div class="faq" style="margin-top:0">
      <h2 style="margin-bottom:24px">Questions fréquentes</h2>
      {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </div>
  </section>

  <section class="section contact" id="contact">
    <div class="wrap">
      <h2>Parlez-nous de votre projet</h2>
      <p class="lead" style="margin-top:20px">Décrivez votre besoin, joignez des photos si vous le souhaitez : nous revenons vers vous avec une proposition adaptée au site, au matériel et à la réglementation.</p>
      <ContactForm />
    </div>
  </section>

  <script>
    // Film d'ouverture : pause / lecture, et respect de « réduire les animations »
    const film = document.getElementById('film') as HTMLVideoElement | null;
    const btn = document.getElementById('film-btn');
    const setLabel = () => { if (btn && film) btn.textContent = film.paused ? 'Lire le film' : 'Mettre en pause'; };
    if (film && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { film.removeAttribute('autoplay'); film.pause(); }
    film?.addEventListener('play', setLabel); film?.addEventListener('pause', setLabel); setLabel();
    btn?.addEventListener('click', () => { if (!film) return; film.paused ? film.play() : film.pause(); });
    const son = document.getElementById('film-son');
    son?.addEventListener('click', () => {
      if (!film) return;
      film.muted = !film.muted;
      son.textContent = film.muted ? 'Activer le son' : 'Couper le son';
      son.setAttribute('aria-pressed', String(!film.muted));
      if (!film.muted && film.paused) film.play();
    });

  </script>
</Base>
