---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ContactForm from '../components/ContactForm.astro';
---
<Base title="Contact et demande de devis · Skysolus, drone et ULM à Hyères" description="Demandez un renseignement ou un devis pour une mission par drone : immobilier, inspection, suivi de chantier, thermographie. Réponse par e-mail ou téléphone.">
  <PageHead crumbs={[['Accueil', '/'], ['Contact']]} title="Contact et demande de devis" lead="Décrivez votre projet : le lieu, ce que vous voulez voir, suivre ou montrer. Vous pouvez joindre des photos ou des documents. Nous revenons vers vous avec une proposition adaptée." />
  <section class="contact" style="padding:20px 0 120px">
    <div class="wrap"><ContactForm /></div>
  </section>
</Base>
