---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import Plane from '../components/Plane.astro';
import Drone from '../components/Drone.astro';
import { flotte } from '../content';
import { prestations } from '../data';
import { pagesSeo } from '../seo';
const titreDe = (id: string) => prestations.find((p) => p.id === id)!.titre;
---
<Base title="Notre flotte : ULM Bristell XL8, DJI Matrice 4T, DJI Mini 5 Pro · Skysolus" description="La flotte Skysolus : l’ULM Bristell XL8 pour la surveillance aérienne, le drone DJI Matrice 4T pour l’inspection et la thermographie, le DJI Mini 5 Pro pour la photo et la vidéo.">
  <PageHead crumbs={[['Accueil', '/'], ['Flotte']]} title="Un avion, deux drones" lead="Chaque appareil a son rôle. Pour chaque mission, nous choisissons celui qui donnera le meilleur résultat dans le cadre réglementaire applicable." />
  <section class="wrap" style="padding-bottom:110px">
    {flotte.map((a, i) => (
      <article class="fleet-row" id={a.id}>
        <div class="fleet-visual">
          {a.id === 'xl8' ? <Plane /> : <Drone model={a.id === 'm4t' ? 'M4T' : 'Mini'} />}
        </div>
        <div class="appareil">
          <p class="type">{a.type}</p>
          <h2 style="font-size:clamp(2rem,3.6vw,2.8rem);margin-bottom:16px">{a.nom}</h2>
          <p class="lead">{a.resume}</p>
          <h3 style="font-size:1.2rem;margin:26px 0 8px">Pourquoi cet appareil</h3>
          <ul>{a.pourquoi.map((x) => <li>{x}</li>)}</ul>
          <h3 style="font-size:1.2rem;margin:26px 0 12px">Prestations associées</h3>
          <div class="other" style="margin-top:0"><ul style="margin-top:0">{a.missions.map((m) => <li><a href={`/prestations/${pagesSeo[m].slug}`}>{titreDe(m)}</a></li>)}</ul></div>
        </div>
      </article>
    ))}
    <p class="muted" style="margin-top:50px">Les illustrations des appareils sont des dessins stylisés.</p>
  </section>
  <CtaBand />
</Base>
