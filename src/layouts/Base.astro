---
import '@fontsource-variable/saira/wdth.css';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import { SITE } from '../config';
import { regions } from '../regions';
import { prestations } from '../data';
import { pagesSeo } from '../seo';

interface Props { title: string; description: string; jsonld?: object[]; noindex?: boolean; }
const { title, description, jsonld = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/og.jpg', SITE.url).href;
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#entreprise`,
  name: SITE.name,
  legalName: `${SITE.legal.denomination} SAS`,
  description: 'Prises de vues, inspections, thermographie, cartographie et surveillance aériennes par drone et ULM, depuis Hyères (Var).',
  url: SITE.url,
  logo: new URL('/img/logo-dark.png', SITE.url).href,
  image: ogImage,
  telephone: SITE.contact.telephone,
  email: SITE.contact.email,
  taxID: SITE.legal.siren.replace(/\s/g, ''),
  address: { '@type': 'PostalAddress', streetAddress: '112 chemin de Beauvallon Bas', addressLocality: 'Hyères', postalCode: '83400', addressRegion: 'Provence-Alpes-Côte d’Azur', addressCountry: 'FR' },
  geo: { '@type': 'GeoCoordinates', latitude: 43.12, longitude: 6.13 },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Var' },
    ...regions.map((r) => ({ '@type': 'AdministrativeArea', name: r.nom })),
    { '@type': 'Country', name: 'France' },
  ],
  knowsAbout: ['Inspection par drone', 'Thermographie infrarouge', 'Photogrammétrie', 'Prises de vues aériennes', 'Surveillance aérienne en ULM'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog', name: 'Prestations Skysolus',
    itemListElement: prestations.map((p) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: p.titre, url: `${SITE.url}/prestations/${pagesSeo[p.id].slug}` } })),
  },
  founder: { '@type': 'Person', name: SITE.legal.president },
  foundingDate: '2026-09-15',
};
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="theme-color" content="#0A1322" />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Skysolus" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="fr_FR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="geo.region" content="FR-83" />
  <meta name="geo.placename" content="Hyères" />
  <script type="application/ld+json" set:html={JSON.stringify(business)} />
  {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <header class="nav" data-nav>
    <a class="nav-logo" href="/" aria-label="Skysolus, accueil"><img src="/img/logo-light.png" alt="Skysolus" width="600" height="165" /></a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="menu" data-toggle>Menu</button>
    <nav id="menu" aria-label="Navigation principale">
      <a href="/prestations">Prestations</a>
      <a href="/flotte">Flotte</a>
      <a href="/zones">Zones</a>
      <a href="/realisations">Réalisations</a>
      <a href="/a-propos">À propos</a>
      <a class="btn btn-small" href="/contact">Demander un devis</a>
    </nav>
  </header>

  <main id="contenu"><slot /></main>

  <footer class="footer">
    <div class="wrap footer-grid">
      <div>
        <img src="/img/logo-light.png" alt="Skysolus" width="600" height="165" class="footer-logo" />
        <p>Prises de vues, inspections et surveillance aériennes par drone et ULM, depuis {SITE.ville}, dans le {SITE.departement}.</p>
      </div>
      <nav class="footer-links" aria-label="Plan du site">
        <a href="/prestations">Prestations</a>
        <a href="/flotte">Flotte</a>
        <a href="/zones">Zones dans le Var</a>
        <a href="/france">Partout en France</a>
        <a href="/realisations">Réalisations</a>
        <a href="/actualites">Actualités</a>
        <a href="/a-propos">À propos</a>
        <a href="/contact">Contact</a>
        <a href="/mentions-legales">Mentions légales</a>
      </nav>
      <div>
        <p><a href={`tel:${SITE.contact.telephone.replace(/\s/g, '')}`}>{SITE.contact.telephone}</a><br />
        <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a></p>
        <p>{SITE.legal.denomination} SAS<br />{SITE.legal.adresse}</p>
      </div>
    </div>
    <p class="wrap footer-copy">© {year} {SITE.name}</p>
  </footer>

  <script>
    const nav = document.querySelector('[data-nav]');
    const btn = document.querySelector('[data-toggle]');
    btn?.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      nav?.classList.toggle('open', !open);
    });
    document.querySelectorAll('#menu a').forEach(a => a.addEventListener('click', () => {
      btn?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('open');
    }));
    const onScroll = () => nav?.classList.toggle('solid', window.scrollY > 40);
    onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
  </script>
</body>
</html>
