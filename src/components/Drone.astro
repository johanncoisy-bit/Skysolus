---
// Silhouettes stylisées vues de dessus : Matrice 4T (pro) et Mini 5 Pro (compact)
interface Props { model: 'M4T' | 'Mini' }
const { model } = Astro.props;
---
{model === 'M4T' ? (
  <svg class="drone" viewBox="-290 -270 580 540" role="img" aria-label="Illustration du drone DJI Matrice 4T vu de dessus">
    <g stroke="#1f2329" stroke-width="26" stroke-linecap="round">
      <line x1="0" y1="0" x2="175" y2="-150" /><line x1="0" y1="0" x2="-175" y2="-150" />
      <line x1="0" y1="0" x2="175" y2="150" /><line x1="0" y1="0" x2="-175" y2="150" />
    </g>
    {[[175, -150], [-175, -150], [175, 150], [-175, 150]].map(([x, y]) => (
      <g transform={`translate(${x} ${y})`}>
        <circle r="98" fill="#cfd8e3" opacity=".12" />
        <circle r="98" fill="none" stroke="#9fb6cc" stroke-opacity=".45" stroke-width="2" />
        <g class="rotor"><rect x="-98" y="-4.5" width="196" height="9" rx="4.5" fill="#3a414b" /></g>
        <circle r="11" fill="#111" />
      </g>
    ))}
    <rect x="-70" y="-110" width="140" height="220" rx="46" fill="#2a2e35" stroke="#5a616c" stroke-width="3" />
    <rect x="-44" y="-70" width="88" height="110" rx="24" fill="#353a43" />
    <rect x="-40" y="-150" width="80" height="54" rx="14" fill="#14171c" stroke="#666" stroke-width="2" />
    <circle cx="-16" cy="-124" r="10" fill="#2a5a86" /><circle cx="14" cy="-124" r="8" fill="#7a2a2a" />
    <circle cx="-150" cy="-178" r="6" fill="#ff4b4b" /><circle cx="150" cy="-178" r="6" fill="#ff4b4b" />
    <circle cx="-150" cy="178" r="6" fill="#3bff7a" /><circle cx="150" cy="178" r="6" fill="#3bff7a" />
  </svg>
) : (
  <svg class="drone" viewBox="-190 -180 380 360" role="img" aria-label="Illustration du drone DJI Mini 5 Pro vu de dessus">
    <g stroke="#a7acb3" stroke-width="16" stroke-linecap="round">
      <line x1="-20" y1="-30" x2="-110" y2="-95" /><line x1="20" y1="-30" x2="110" y2="-95" />
      <line x1="-20" y1="30" x2="-115" y2="85" /><line x1="20" y1="30" x2="115" y2="85" />
    </g>
    {[[-110, -95], [110, -95], [-115, 85], [115, 85]].map(([x, y]) => (
      <g transform={`translate(${x} ${y})`}>
        <circle r="62" fill="#cfd8e3" opacity=".12" />
        <circle r="62" fill="none" stroke="#9fb6cc" stroke-opacity=".45" stroke-width="2" />
        <g class="rotor"><rect x="-62" y="-3" width="124" height="6" rx="3" fill="#59606b" /></g>
        <circle r="8" fill="#111" />
      </g>
    ))}
    <path d="M-42 -70 C-42 -95 42 -95 42 -70 L48 60 C48 92 -48 92 -48 60 Z" fill="#d8dbe0" stroke="#8d939b" stroke-width="3" />
    <path d="M-26 -40 C-26 -55 26 -55 26 -40 L28 30 C28 46 -28 46 -28 30 Z" fill="#c4c8ce" />
    <rect x="-22" y="-112" width="44" height="34" rx="10" fill="#1b1e23" />
    <circle cx="0" cy="-95" r="11" fill="#2a5a86" />
  </svg>
)}
