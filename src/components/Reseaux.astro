---
// Liens vers les réseaux sociaux de Skysolus (config.ts › reseaux).
// Icônes génériques (bouton lecture, appareil photo, bulle), volontairement différentes des logos des marques.
import { SITE } from '../config';
interface Props { titre?: string; variante?: 'rail' | 'menu' | 'grand' }
const { titre, variante } = Astro.props;
const liens = SITE.reseaux.filter((r) => r.url);
const icone: Record<string, string> = {
  YouTube: '<circle cx="12" cy="12" r="9.2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 8.2v7.6l6-3.8z" fill="currentColor"/>',
  Instagram: '<path d="M3.5 8.5A1.5 1.5 0 0 1 5 7h2.6l1.4-2h6l1.4 2H19a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 19 19H5a1.5 1.5 0 0 1-1.5-1.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="13" r="3.4" fill="none" stroke="currentColor" stroke-width="1.6"/>',
  Facebook: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v9a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A2.5 2.5 0 0 1 3 14.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>',
};
---
{liens.length > 0 && (
  <div class:list={['reseaux', variante && `reseaux-${variante}`]} role={variante === 'rail' ? 'complementary' : undefined} aria-label={variante === 'rail' ? 'Réseaux sociaux' : undefined}>
    {titre && <p class="reseaux-titre">{titre}</p>}
    <ul>
      {liens.map((r) => (
        <li>
          <a href={r.url} target="_blank" rel="noopener me" title={variante === 'rail' ? r.nom : undefined} aria-label={`Skysolus sur ${r.nom} (nouvelle fenêtre)`}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" set:html={icone[r.nom] ?? ''}></svg>
            <span>{r.nom}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
